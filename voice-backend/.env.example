# Public HTTPS URL of this backend, without a trailing slash.
PUBLIC_BASE_URL=https://your-golos-backend.example.com
PORT=3000
DATA_DIR=./data
TRUST_PROXY_HOPS=1

# Generate a long random value (at least 32 bytes). Enter the same value
# into the Golos app's secure server settings. Never commit the real value.
GOLOS_APP_API_TOKEN=replace-with-a-long-random-secret

# Twilio credentials. Keep every value on the server only.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-me
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=replace-me
TWILIO_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PUSH_CREDENTIAL_SID=
TWILIO_CALLER_ID=+31xxxxxxxxx

# Empty means DENY ALL outbound destinations. Add only permitted E.164 prefixes.
ALLOWED_DIAL_PREFIXES=
